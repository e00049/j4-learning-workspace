FROM python:3.12-slim
WORKDIR /app

COPY requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements-mcp.txt

COPY mcp_server/wallettracker_mcp.py mcp_server/
COPY data/transactions_sep2026.csv data/

RUN useradd --create-home appuser
USER appuser

ENV MCP_TRANSPORT=streamable-http \
    PORT=8080
EXPOSE 8080
CMD ["python", "mcp_server/wallettracker_mcp.py"]

